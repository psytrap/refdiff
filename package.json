{
  "name": "refdiff",
  "version": "1.5.4",
  "description": "Zero-loss citation decoupling gadget and diff driver for Wikipedia / MediaWiki Special:Diff",
  "main": "refdiff.js",
  "scripts": {
    "lint": "eslint refdiff.js tests/**/*.js scripts/**/*.js",
    "test": "node tests/runner.js",
    "test:live": "python3 tests/test_live_cdp.py",
    "test:bench": "python3 tests/test_live_benchmarks.py",
    "preflight": "npm run ci && node tests/test_deployment.js && npm run test:live && npm run test:bench",
    "check:deploy": "node scripts/check_live_deployment.js",
    "check:installer": "python3 scripts/check_toolpage_installer.py",
    "bump": "node scripts/bump_version.js",
    "inspect": "python3 scripts/inspect_diff.py",
    "capture": "python3 scripts/capture_full_audit.py",
    "ci": "npm run lint && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m-k/einzelnachweise.git"
  },
  "keywords": [
    "wikipedia",
    "mediawiki",
    "diff",
    "citations",
    "userscript"
  ],
  "author": "RefDiff Contributors",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^6.4.0",
    "jsdom": "^30.1.2"
  }
}
